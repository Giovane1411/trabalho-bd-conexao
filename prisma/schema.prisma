generator client {
  provider = "prisma-client"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = "mysql://root:@localhost:3306/trabalho_bd"
}

model tarefas {
  id         Int       @id @default(autoincrement())
  descricao  String?   @db.VarChar(255)
  id_usuario Int?
  usuarios   usuarios? @relation(fields: [id_usuario], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "tarefas_ibfk_1")

  @@index([id_usuario], map: "id_usuario")
}

model usuarios {
  id      Int       @id @default(autoincrement())
  nome    String?   @db.VarChar(100)
  email   String?   @unique(map: "email") @db.VarChar(100)
  tarefas tarefas[]
}
